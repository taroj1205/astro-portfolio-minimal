---
// Coastlines: Natural Earth 110m land (world-atlas), equirectangular,
// longitude 108°E to 182°E and latitude 42°N to 47°S, drawn 600 wide.
import land from '../assets/map/asia-pacific-land.txt?raw'

const W = 600
const H = 722
const equator = 340.5

const place = {
  tokyo: [257, 51],
  ehime: [201, 66],
  philippines: [129, 257],
  auckland: [541, 639],
} as const

const { tokyo, ehime, philippines, auckland } = place
const route = [
  `M${tokyo}`,
  `Q229,26 ${ehime}`,
  `Q480,240 ${auckland}`,
  `Q250,600 ${philippines}`,
  `Q420,400 ${auckland}`,
].join(' ')

const labels = [
  { at: tokyo, n: '1', name: 'Tokyo', dx: 12, dy: 5, anchor: 'start' },
  { at: ehime, n: '2', name: 'Ehime', dx: -12, dy: 18, anchor: 'end' },
  {
    at: philippines,
    n: '4',
    name: 'Philippines',
    dx: 14,
    dy: 5,
    anchor: 'start',
  },
  { at: auckland, n: '3, 5', name: 'Auckland', dx: -14, dy: 5, anchor: 'end' },
]

const stops = [
  { place: 'Tokyo', text: 'Born here in 2005.' },
  { place: 'Ehime', text: 'Moved here after the 2011 earthquake.' },
  { place: 'Auckland', text: 'A year at an intermediate school.' },
  {
    place: 'The Philippines',
    text: 'Three months learning English in Cebu, then a year at a British school.',
  },
  {
    place: 'Auckland',
    text: 'Back for good in 2019. Westlake Boys, then the University of Auckland.',
  },
]
---

<div class="journey">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="Map from Japan to New Zealand showing the places I've lived, in order: Tokyo, Ehime, Auckland, the Philippines, and back to Auckland."
  >
    <path class="land" d={land}></path>
    <line class="equator" x1="0" x2={W} y1={equator} y2={equator}></line>
    <text class="equator-label" x="8" y={equator - 8}>Equator</text>
    <path class="route" d={route} pathLength="1"></path>
    {
      labels.map(l => (
        <g>
          <circle class="stop" cx={l.at[0]} cy={l.at[1]} r="6" />
          <text
            x={l.at[0] + l.dx}
            y={l.at[1] + l.dy}
            text-anchor={l.anchor}
            class="place"
          >
            <tspan class="n">{l.n}</tspan> {l.name}
          </text>
        </g>
      ))
    }
  </svg>

  <ol class="stops">
    {
      stops.map(stop => (
        <li>
          <h3>{stop.place}</h3>
          <p>{stop.text}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .journey {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.5rem;
    align-items: center;
  }

  svg {
    grid-column: 1 / span 6;
    width: 100%;
    height: auto;
    font-size: 20px;
  }

  .land {
    fill: #dce5e6;
  }

  .equator {
    stroke: var(--stone);
    stroke-dasharray: 2 6;
    opacity: 0.6;
  }

  .equator-label {
    fill: var(--stone);
    font-size: 15px;
  }

  .route {
    fill: none;
    stroke: var(--sun);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .stop {
    fill: var(--ink);
    stroke: var(--sky);
    stroke-width: 3;
  }

  .place {
    fill: var(--ink);
    font-weight: 650;
    paint-order: stroke;
    stroke: var(--sky);
    stroke-width: 5;
    stroke-linejoin: round;
  }

  .n {
    fill: var(--sun);
  }

  .stops {
    grid-column: 8 / -1;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: stop;
  }

  .stops li {
    counter-increment: stop;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .stops li::before {
    content: counter(stop);
    grid-row: span 2;
    color: var(--sun);
    font-weight: 750;
    font-stretch: 125%;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .stops h3 {
    font-size: 1.25rem;
    font-stretch: 112%;
    letter-spacing: -0.015em;
  }

  .stops p {
    margin-top: 0.3rem;
    color: var(--stone);
    font-size: 1rem;
  }

  /* The route draws itself as the map scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .route {
        stroke-dasharray: 1;
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 55%;
      }
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 800px) {
    svg,
    .stops {
      grid-column: 1 / -1;
    }

    svg {
      max-width: 26rem;
      margin: 0 auto 2rem;
    }
  }
</style>

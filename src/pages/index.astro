---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import portrait from '../assets/photos/portrait-sakura-mask.webp'
import partlyCert from '../assets/hackathon/partly/IMG_20250727_213900.jpg'
import partlyTeam from '../assets/hackathon/partly/IMG_7138.jpeg'
import sesaCert from '../assets/hackathon/sesa-wdcc/IMG_20250803_222749.jpg'
import sesaTeam from '../assets/hackathon/sesa-wdcc/20250803_210127.jpg'
import Layout from '../layouts/layout.astro'

const marquee = [
  'Yamada UI maintainer',
  'Zen Browser website architect',
  '1,190+ pull requests',
  'sonner feature shipped in v2.0.7',
  'Hackathon award winner',
  'TypeScript · Next.js · Astro',
  'Auckland ↔ Tokyo',
  'Building since 2022',
]

const photos: Record<string, ImageMetadata> = {
  partlyCert,
  partlyTeam,
  sesaCert,
  sesaTeam,
}
---

<Layout
  title="Shintaro Jokagi · Builder & Open Source Maintainer"
  description="Shintaro Jokagi is a software engineer and open-source maintainer. He builds interfaces people actually use, and contributes to the tools other developers rely on."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="hero-title">
          <span class="line"><span>Hi, I'm</span></span>
          <span class="line"><span><em>Shintaro</em>.</span></span>
          <span class="line">
            <span>
              I make things
              <span class="rotator" data-rotator aria-label="roles">
                <span>people love.</span>
                <span>developers trust.</span>
                <span>that ship.</span>
              </span>
            </span>
          </span>
        </h1>

        <p class="hero-copy">
          I'm a software engineer in Auckland. I build product interfaces at
          Hazumi, and keep open-source tools healthy, the ones other developers
          end up using every day.
        </p>

        <div class="hero-actions">
          <a class="text-link" href="#impact">
            Open source work
            <span aria-hidden="true">↓</span>
          </a>
          <a class="text-link" href="mailto:taroj1205@gmail.com">
            taroj1205@gmail.com
          </a>
        </div>

        <div class="hero-meta">
          <div>
            <strong>Yamada UI</strong>
            Maintainer
          </div>
          <div>
            <strong>Zen Browser</strong>
            Core Website Architect
          </div>
          <div>
            <strong>Hazumi Inc.</strong>
            Software Engineer
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <svg
          class="hero-doodle d1"
          viewBox="0 0 80 40"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 28c12-18 28-22 44-14 10 5 18 4 28-6"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"></path>
          <path
            d="M64 4l12 4-8 10"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>

        <div class="hero-card">
          <Image
            src={portrait}
            alt="Shintaro under cherry blossoms in Auckland"
            width={1206}
            height={2144}
            loading="eager"
          />
        </div>

        <div class="float-chip chip-a">
          1,190+ PRs
          <small>merged & reviewed</small>
        </div>
        <div class="float-chip chip-b">
          2 awards
          <small>hackathon wins</small>
        </div>
        <div class="float-chip chip-c">
          Since 2022
          <small>self-taught builder</small>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [...marquee, ...marquee].map(item => (
          <div class="marquee-item">
            <span class="sep" />
            <span>{item}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- STATS -->
  <section class="section-pad">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <div class="eyebrow">By the numbers</div>
          <h2 class="display">
            Work that shows up<br />outside this site.
          </h2>
        </div>
        <p>
          Design systems other teams build on. A browser site people hit before
          they download anything. A toast library that shipped a feature I
          wrote. I care about what happens after the merge.
        </p>
      </div>

      <div class="stats">
        <div class="stat-card" data-reveal style="--delay: 0ms">
          <div class="stat-value">
            <span data-count="1190">0</span><span class="unit">+</span>
          </div>
          <div class="stat-label">
            Pull requests authored across open source and product work
          </div>
        </div>
        <div class="stat-card" data-reveal style="--delay: 80ms">
          <div class="stat-value">
            <span data-count="155">0</span>
          </div>
          <div class="stat-label">
            Pull requests to Yamada UI as an official maintainer
          </div>
        </div>
        <div class="stat-card" data-reveal style="--delay: 160ms">
          <div class="stat-value">
            <span data-count="89">0</span>
          </div>
          <div class="stat-label">
            Pull requests shaping the Zen Browser website experience
          </div>
        </div>
        <div class="stat-card" data-reveal style="--delay: 240ms">
          <div class="stat-value">
            <span data-count="3">0</span>
          </div>
          <div class="stat-label">
            Countries lived in · Japan, Philippines, New Zealand
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPACT -->
  <section class="section-pad impact" id="impact">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <div class="eyebrow">Open source</div>
          <h2 class="display">
            The libraries and sites<br />behind other people's work.
          </h2>
        </div>
        <p>
          Most of what I'm proud of sits one layer down, in a design system, a
          browser website, a small library. Not flashy, but it keeps other
          people moving.
        </p>
      </div>

      <div class="impact-grid">
        <!-- Yamada -->
        <article class="impact-card" data-reveal>
          <div class="impact-visual yamada">
            <div class="impact-badge">
              <div class="brand">Yamada UI</div>
              <div class="role">Official maintainer · since Feb 2024</div>
              <div class="mini-stat">
                <div>
                  <strong>155</strong>
                  <span>PRs</span>
                </div>
                <div>
                  <strong>263</strong>
                  <span>issues</span>
                </div>
                <div>
                  <strong>~16</strong>
                  <span>maintainers</span>
                </div>
              </div>
            </div>
          </div>
          <div class="impact-body">
            <h3>Keeping a design system healthy for real teams</h3>
            <p>
              I'm one of the official maintainers. I review PRs, fix a11y
              issues, clean up docs. It's unglamorous work that keeps a UI
              library usable.
            </p>
            <ul class="impact-points">
              <li>Docs navigation, locale menus, and scroll UX polish</li>
              <li>Menu accessibility and component selector fixes</li>
              <li>Security CI improvements with zizmor</li>
            </ul>
            <a
              class="impact-link"
              href="https://yamada-ui.com"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Yamada UI
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </article>

        <!-- Zen -->
        <article class="impact-card reverse" data-reveal>
          <div class="impact-body">
            <h3>Architecting the face of Zen Browser</h3>
            <p>
              Zen's about page credits me as <strong
                >Core Website Architect</strong
              >. I'm the person who keeps refactoring and upgrading their public
              site so it stays fast and clear.
            </p>
            <ul class="impact-points">
              <li>Tailwind v4 migration and Turborepo performance work</li>
              <li>Playwright, Vitest, and CI foundations</li>
              <li>Internationalization including Japanese support</li>
            </ul>
            <a
              class="impact-link"
              href="https://zen-browser.app"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Zen Browser
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
          <div class="impact-visual zen">
            <div class="impact-badge" style="transform: rotate(2deg)">
              <div class="brand">Zen Browser</div>
              <div class="role">Core Website Architect</div>
              <div class="mini-stat">
                <div>
                  <strong>89</strong>
                  <span>website PRs</span>
                </div>
                <div>
                  <strong>228</strong>
                  <span>contributions</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- sonner + shadcn -->
        <article class="impact-card" data-reveal>
          <div class="impact-visual sonner">
            <div class="impact-badge" style="transform: rotate(-1.5deg)">
              <div class="brand">sonner</div>
              <div class="role">Feature shipped in v2.0.7</div>
              <div class="mini-stat">
                <div>
                  <strong>#665</strong>
                  <span>merged PR</span>
                </div>
                <div>
                  <strong>Multi</strong>
                  <span>toaster support</span>
                </div>
              </div>
            </div>
          </div>
          <div class="impact-body">
            <h3>A small PR that now greets people in production</h3>
            <p>
              I added multiple-toast support to <strong>sonner</strong>. The
              maintainer merged it and it shipped in v2.0.7. If you've used that
              library recently, that feature might be mine.
            </p>
            <ul class="impact-points">
              <li>Feature PR merged and released to real users</li>
              <li>Also contributed fixes to shadcn/ui (Turbo, 404, mobile)</li>
              <li>Debug support for opencode and t3code communities</li>
            </ul>
            <a
              class="impact-link"
              href="https://github.com/emilkowalski/sonner"
              target="_blank"
              rel="noopener noreferrer"
            >
              See sonner
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="section-pad" id="work">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <div class="eyebrow">Selected work</div>
          <h2 class="display">
            Side projects with<br />a real reason to exist.
          </h2>
        </div>
        <p>
          My brother wanted a better way to read note.com. I wanted a faster
          clipboard. Small tools, built for someone specific. Sometimes that
          someone is me.
        </p>
      </div>

      <div class="work-grid">
        <a
          class="work-card"
          href="https://github.com/taroj1205/nextjs-note-rss-minytheminer"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style="--delay: 90ms"
        >
          <div class="tag-row">
            <span class="tag">Next.js</span>
            <span class="tag warm">For family</span>
          </div>
          <h3>Note Article List</h3>
          <p>
            A calm reading list for my younger brother, pulling essays from
            note.com into a simple, beautiful place to catch up.
          </p>
          <div class="footer">
            <div class="metric">
              Built with care
              <small>one brother, one better feed</small>
            </div>
            <span class="go" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </a>

        <a
          class="work-card"
          href="https://github.com/taroj1205/tauri-clipboard-manager"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style="--delay: 160ms"
        >
          <div class="tag-row">
            <span class="tag">Rust</span>
            <span class="tag">Tauri</span>
          </div>
          <h3>Clipboard Manager</h3>
          <p>
            A desktop clipboard manager with image search. Exploring native
            performance, local-first tools, and snappy everyday utilities.
          </p>
          <div class="footer">
            <div class="metric">
              Native tools
              <small>Rust · Tauri · Solid.js</small>
            </div>
            <span class="go" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="section-pad story" id="story">
    <div class="wrap">
      <div class="story-grid">
        <div data-reveal>
          <div class="eyebrow warm">The short story</div>
          <h2>
            Self-taught.<br />Three countries.<br />Still figuring it out.
          </h2>
          <p class="lead">
            I started building in 2022 and kept going. Along the way I taught
            kids to code in Minecraft, worked on a browser website people use
            around the world, and learned most of software is just about people.
          </p>
          <div class="story-note">
            <strong>Right now:</strong> software engineer at Hazumi Inc. in Tokyo
            (remote from Auckland), finishing a BSc in Computer Science + IT Management
            at the University of Auckland.
          </div>
        </div>

        <div class="story-points">
          <div class="story-point" data-reveal style="--delay: 0ms">
            <div class="year">2022</div>
            <div>
              <h3>Started building properly</h3>
              <p>
                Typing games, board games, small web apps. Teaching myself by
                shipping things that felt real.
              </p>
            </div>
          </div>
          <div class="story-point" data-reveal style="--delay: 80ms">
            <div class="year">2024</div>
            <div>
              <h3>Joined the maintainers</h3>
              <p>
                Became a Yamada UI maintainer and started contributing to the
                Zen Browser website, then kept going.
              </p>
            </div>
          </div>
          <div class="story-point" data-reveal style="--delay: 160ms">
            <div class="year">2025</div>
            <div>
              <h3>Shipped & taught</h3>
              <p>
                Won two hackathon awards, taught Japanese kids programming over
                Zoom, and joined Hazumi Inc. as a software engineer.
              </p>
            </div>
          </div>
          <div class="story-point" data-reveal style="--delay: 240ms">
            <div class="year">Now</div>
            <div>
              <h3>Building the next thing</h3>
              <p>
                Product work at Hazumi, open-source craft, desktop experiments
                in Swift and Rust, and this portfolio.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AWARDS -->
  <section class="section-pad" id="awards">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <div class="eyebrow warm">Awards</div>
          <h2 class="display">
            Recognition from<br />long weekends of building.
          </h2>
        </div>
        <p>
          Hackathons are where pressure and play collide. These two weekends
          ended with trophies and a lot of pizza.
        </p>
      </div>

      <div class="awards-grid">
        <article class="award-card" data-reveal>
          <div class="award-polaroid">
            <figure class="award-photo award-photo--main">
              <Image
                src={photos.partlyTeam}
                alt="Team 3 holding the Partly × WDCC award"
                width={1200}
                height={800}
                loading="lazy"
              />
            </figure>
            <figure class="award-photo award-photo--cert">
              <Image
                src={photos.partlyCert}
                alt="Partly × WDCC certificate for Most Production Ready"
                width={640}
                height={454}
                loading="lazy"
              />
            </figure>
          </div>
          <div class="award-body">
            <div class="prize">Most production ready</div>
            <h3>Partly × WDCC</h3>
            <p class="award-meta">July 2025 · Team 3</p>
            <p>
              Recognized for building something that felt ready for the real
              world, not just the demo stage.
            </p>
          </div>
        </article>

        <article class="award-card" data-reveal style="--delay: 100ms">
          <div class="award-polaroid">
            <figure class="award-photo award-photo--main">
              <Image
                src={photos.sesaTeam}
                alt="Exception Handlers holding Most Overengineered certificates"
                width={1200}
                height={900}
                loading="lazy"
              />
            </figure>
            <figure class="award-photo award-photo--cert">
              <Image
                src={photos.sesaCert}
                alt="SESA × WDCC certificate for Most Overengineered"
                width={640}
                height={480}
                loading="lazy"
              />
            </figure>
          </div>
          <div class="award-body">
            <div class="prize">Most overengineered</div>
            <h3>SESA × WDCC</h3>
            <p class="award-meta">August 2025 · GridAKL</p>
            <p>
              New Zealand's largest tertiary hackathon. A 48-hour sprint that
              earned the most delightfully overbuilt award.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section-pad contact" id="contact">
    <div class="wrap">
      <div class="contact-panel" data-reveal>
        <div class="eyebrow">Next chapter</div>
        <h2>Want to build something together?</h2>
        <p class="lead">
          Open source, product work, or just a chat. Email is the easiest.
        </p>
        <div class="contact-actions">
          <a class="text-link" href="mailto:taroj1205@gmail.com">
            taroj1205@gmail.com
          </a>
          <a
            class="text-link"
            href="https://github.com/sponsors/taroj1205"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub Sponsors
          </a>
        </div>
        <div class="social-row">
          <a
            href="https://github.com/taroj1205"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          <a
            href="https://x.com/taroj1205"
            target="_blank"
            rel="noopener noreferrer">X</a
          >
          <a
            href="https://www.linkedin.com/in/taroj/"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <a
            href="https://zenn.dev/taroj1205"
            target="_blank"
            rel="noopener noreferrer">Zenn</a
          >
          <a href="/about">About</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

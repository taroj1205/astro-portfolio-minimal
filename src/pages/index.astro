---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import heroAbstract from '../assets/gen/hero-abstract.png'
import partlyCert from '../assets/hackathon/partly/IMG_20250727_213900.jpg'
import partlyHolding from '../assets/hackathon/partly/IMG_7138.jpeg'
import sesaHolding from '../assets/hackathon/sesa-wdcc/20250803_210127.jpg'
import sesaCert from '../assets/hackathon/sesa-wdcc/IMG_20250803_222749.jpg'
import Layout from '../layouts/layout.astro'

const marquee = [
  'Yamada UI maintainer',
  'Zen Browser website architect',
  '1,190+ pull requests',
  'sonner feature shipped in v2.0.7',
  'Hackathon award winner',
  'TypeScript · Next.js · Astro',
  'Auckland ↔ Tokyo',
  'Self-taught since 2020',
]

const photos: Record<string, ImageMetadata> = {
  partlyCert,
  partlyHolding,
  sesaHolding,
  sesaCert,
}
---

<Layout
  title="Shintaro Jokagi — Builder & Open Source Maintainer"
  description="Shintaro Jokagi is a software engineer and open-source maintainer. He builds interfaces people actually use — and contributes to the tools other developers rely on."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="hero-kicker">
          <span class="dot" aria-hidden="true"></span>
          Open to thoughtful collaborations
        </div>

        <h1 class="hero-title">
          <span class="line"><span>Hi, I'm</span></span>
          <span class="line"><span><em>Shintaro</em>.</span></span>
          <span class="line">
            <span>
              I make things
              <span class="rotator" data-rotator aria-label="roles">
                <span>people love.</span>
                <span>developers trust.</span>
                <span>that ship.</span>
              </span>
            </span>
          </span>
        </h1>

        <p class="hero-copy">
          Software engineer in Auckland. I craft polished product interfaces by
          day, and maintain open-source tools that thousands of developers build
          with.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#impact" data-magnetic>
            See my impact
            <svg
              class="btn-arrow"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            class="btn btn-ghost"
            href="mailto:taroj1205@gmail.com"
            data-magnetic
          >
            Let's talk
          </a>
        </div>

        <div class="hero-meta">
          <div>
            <strong>Yamada UI</strong>
            Maintainer
          </div>
          <div>
            <strong>Zen Browser</strong>
            Core Website Architect
          </div>
          <div>
            <strong>Hazumi Inc.</strong>
            Software Engineer
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <svg
          class="hero-doodle d1"
          viewBox="0 0 80 40"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 28c12-18 28-22 44-14 10 5 18 4 28-6"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"></path>
          <path
            d="M64 4l12 4-8 10"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>

        <div class="hero-card">
          <Image
            src={heroAbstract}
            alt="Soft abstract shapes in cream, cobalt, and tangerine"
            width={1536}
            height={1024}
            loading="eager"
          />
        </div>

        <div class="float-chip chip-a">
          1,190+ PRs
          <small>merged & reviewed</small>
        </div>
        <div class="float-chip chip-b">
          2 awards
          <small>hackathon wins</small>
        </div>
        <div class="float-chip chip-c">
          Since 2020
          <small>self-taught builder</small>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [...marquee, ...marquee].map(item => (
          <div class="marquee-item">
            <span class="sep" />
            <span>{item}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- STATS -->
  <section class="section-pad">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <div class="eyebrow">By the numbers</div>
          <h2 class="display">
            Impact you can feel —<br />not just code on a screen.
          </h2>
        </div>
        <p>
          Whether it's a design system used by product teams, a browser site
          visited by newcomers every day, or a toast library that just works — I
          care about what happens after the merge button.
        </p>
      </div>

      <div class="stats">
        <div class="stat-card" data-reveal style="--delay: 0ms">
          <div class="stat-value">
            <span data-count="1190">0</span><span class="unit">+</span>
          </div>
          <div class="stat-label">
            Pull requests authored across open source and product work
          </div>
        </div>
        <div class="stat-card" data-reveal style="--delay: 80ms">
          <div class="stat-value">
            <span data-count="155">0</span>
          </div>
          <div class="stat-label">
            Pull requests to Yamada UI as an official maintainer
          </div>
        </div>
        <div class="stat-card" data-reveal style="--delay: 160ms">
          <div class="stat-value">
            <span data-count="89">0</span>
          </div>
          <div class="stat-label">
            Pull requests shaping the Zen Browser website experience
          </div>
        </div>
        <div class="stat-card" data-reveal style="--delay: 240ms">
          <div class="stat-value">
            <span data-count="3">0</span>
          </div>
          <div class="stat-label">
            Countries lived in · Japan, Philippines, New Zealand
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPACT -->
  <section class="section-pad impact" id="impact">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <div class="eyebrow">Open source</div>
          <h2 class="display">
            The tools behind<br />the tools people love.
          </h2>
        </div>
        <p>
          My favourite work lives one layer down — in libraries, design systems,
          and product surfaces that quietly make other people's work better.
        </p>
      </div>

      <div class="impact-grid">
        <!-- Yamada -->
        <article class="impact-card" data-reveal>
          <div class="impact-visual yamada">
            <div class="impact-badge">
              <div class="brand">Yamada UI</div>
              <div class="role">Official maintainer · since Feb 2024</div>
              <div class="mini-stat">
                <div>
                  <strong>155</strong>
                  <span>PRs</span>
                </div>
                <div>
                  <strong>263</strong>
                  <span>issues</span>
                </div>
                <div>
                  <strong>~16</strong>
                  <span>maintainers</span>
                </div>
              </div>
            </div>
          </div>
          <div class="impact-body">
            <h3>Keeping a design system healthy for real teams</h3>
            <p>
              As one of the official maintainers, I help review contributions,
              fix accessibility gaps, improve docs, and keep the developer
              experience tight — so product teams can ship UI with confidence.
            </p>
            <ul class="impact-points">
              <li>Docs navigation, locale menus, and scroll UX polish</li>
              <li>Menu accessibility and component selector fixes</li>
              <li>Security CI improvements with zizmor</li>
            </ul>
            <a
              class="impact-link"
              href="https://yamada-ui.com"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Yamada UI
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </article>

        <!-- Zen -->
        <article class="impact-card reverse" data-reveal>
          <div class="impact-body">
            <h3>Architecting the face of Zen Browser</h3>
            <p>
              Officially credited as <strong>Core Website Architect</strong> on Zen's
              about page — leading refactors and technical upgrades that make the
              browser's public site faster, clearer, and ready for the world.
            </p>
            <ul class="impact-points">
              <li>Tailwind v4 migration and Turborepo performance work</li>
              <li>Playwright, Vitest, and CI foundations</li>
              <li>Internationalization including Japanese support</li>
            </ul>
            <a
              class="impact-link"
              href="https://zen-browser.app"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Zen Browser
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
          <div class="impact-visual zen">
            <div class="impact-badge" style="transform: rotate(2deg)">
              <div class="brand">Zen Browser</div>
              <div class="role">Core Website Architect</div>
              <div class="mini-stat">
                <div>
                  <strong>89</strong>
                  <span>website PRs</span>
                </div>
                <div>
                  <strong>228</strong>
                  <span>contributions</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- sonner + shadcn -->
        <article class="impact-card" data-reveal>
          <div class="impact-visual sonner">
            <div class="impact-badge" style="transform: rotate(-1.5deg)">
              <div class="brand">sonner</div>
              <div class="role">Feature shipped in v2.0.7</div>
              <div class="mini-stat">
                <div>
                  <strong>#665</strong>
                  <span>merged PR</span>
                </div>
                <div>
                  <strong>Multi</strong>
                  <span>toaster support</span>
                </div>
              </div>
            </div>
          </div>
          <div class="impact-body">
            <h3>A small PR that now greets people in production</h3>
            <p>
              I contributed multiple-toast support to <strong>sonner</strong> — the
              toast library used across modern product UIs. It shipped in v2.0.7 after
              the maintainer closed a long-standing issue with it.
            </p>
            <ul class="impact-points">
              <li>Feature PR merged and released to real users</li>
              <li>Also contributed fixes to shadcn/ui (Turbo, 404, mobile)</li>
              <li>Debug support for opencode and t3code communities</li>
            </ul>
            <a
              class="impact-link"
              href="https://github.com/emilkowalski/sonner"
              target="_blank"
              rel="noopener noreferrer"
            >
              See sonner
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="section-pad" id="work">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <div class="eyebrow">Selected work</div>
          <h2 class="display">
            Things I've built<br />for people I care about.
          </h2>
        </div>
        <p>
          I like projects with a clear human reason to exist — a club that
          needed a home online, a sibling who wanted a better reading list, a
          classroom that learned to code through play.
        </p>
      </div>

      <div class="work-grid">
        <a
          class="work-card featured"
          href="https://uoabadminton.co.nz"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
        >
          <div class="work-deco" aria-hidden="true"></div>
          <div class="tag-row">
            <span class="tag">Full stack</span>
            <span class="tag warm">Live product</span>
            <span class="tag">Team project</span>
          </div>
          <h3>UoA Badminton Club</h3>
          <p>
            The official website for the University of Auckland Badminton Club —
            built with the WDCC team. I was the top human contributor with 166
            pull requests across the club's digital home.
          </p>
          <div class="footer">
            <div class="metric">
              166 PRs
              <small>as lead web developer</small>
            </div>
            <span class="go" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </a>

        <a
          class="work-card"
          href="https://github.com/taroj1205/nextjs-note-rss-minytheminer"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style="--delay: 90ms"
        >
          <div class="tag-row">
            <span class="tag">Next.js</span>
            <span class="tag warm">For family</span>
          </div>
          <h3>Note Article List</h3>
          <p>
            A calm reading list for my younger brother — pulling essays from
            note.com into a simple, beautiful place to catch up.
          </p>
          <div class="footer">
            <div class="metric">
              Built with care
              <small>one brother, one better feed</small>
            </div>
            <span class="go" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </a>

        <a
          class="work-card"
          href="https://github.com/taroj1205/tauri-clipboard-manager"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style="--delay: 160ms"
        >
          <div class="tag-row">
            <span class="tag">Rust</span>
            <span class="tag">Tauri</span>
          </div>
          <h3>Clipboard Manager</h3>
          <p>
            A desktop clipboard manager with image search — exploring native
            performance, local-first tools, and snappy everyday utilities.
          </p>
          <div class="footer">
            <div class="metric">
              Native tools
              <small>Rust · Tauri · Solid.js</small>
            </div>
            <span class="go" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="section-pad story" id="story">
    <div class="wrap">
      <div class="story-grid">
        <div data-reveal>
          <div class="eyebrow warm">The short story</div>
          <h2>Self-taught.<br />Three countries.<br />Still curious.</h2>
          <p class="lead">
            I started coding in 2020 and never really stopped. Along the way
            I've taught kids to program in Minecraft, rebuilt browser websites
            used around the world, and learned that great software is mostly
            about people.
          </p>
          <div class="story-note">
            <strong>Currently:</strong> software engineer at Hazumi Inc. in Tokyo
            (remote from Auckland), finishing a BSc in Computer Science + IT Management
            at the University of Auckland.
          </div>
        </div>

        <div class="story-points">
          <div class="story-point" data-reveal style="--delay: 0ms">
            <div class="year">2020</div>
            <div>
              <h3>Started building</h3>
              <p>
                Typing games, board games, small web apps — teaching myself by
                shipping things that felt real.
              </p>
            </div>
          </div>
          <div class="story-point" data-reveal style="--delay: 80ms">
            <div class="year">2024</div>
            <div>
              <h3>Joined the maintainers</h3>
              <p>
                Became a Yamada UI maintainer and started contributing to the
                Zen Browser website — then kept going.
              </p>
            </div>
          </div>
          <div class="story-point" data-reveal style="--delay: 160ms">
            <div class="year">2025</div>
            <div>
              <h3>Shipped & taught</h3>
              <p>
                Won two hackathon awards, taught Japanese kids programming over
                Zoom, and joined Hazumi Inc. as a software engineer.
              </p>
            </div>
          </div>
          <div class="story-point" data-reveal style="--delay: 240ms">
            <div class="year">Now</div>
            <div>
              <h3>Building the next thing</h3>
              <p>
                Product work at Hazumi, open-source craft, desktop experiments
                in Swift and Rust, and this portfolio.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AWARDS -->
  <section class="section-pad" id="awards">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <div class="eyebrow warm">Awards</div>
          <h2 class="display">
            Recognition from<br />long weekends of building.
          </h2>
        </div>
        <p>
          Hackathons are where pressure and play collide. These two weekends
          ended with trophies — and a lot of pizza.
        </p>
      </div>

      <div class="awards-grid">
        <article class="award-card" data-reveal>
          <div class="award-photos">
            <figure>
              <Image
                src={photos.partlyHolding}
                alt="Shintaro holding the Partly × WDCC award"
                width={1200}
                height={900}
                loading="lazy"
              />
            </figure>
            <figure>
              <Image
                src={photos.partlyCert}
                alt="Partly × WDCC certificate"
                width={1200}
                height={900}
                loading="lazy"
              />
            </figure>
          </div>
          <div class="prize">Most production ready</div>
          <h3>Partly × WDCC</h3>
          <p>
            July 2025 — recognized for building something that felt ready for
            the real world, not just the demo stage.
          </p>
        </article>

        <article class="award-card" data-reveal style="--delay: 100ms">
          <div class="award-photos">
            <figure>
              <Image
                src={photos.sesaHolding}
                alt="Shintaro holding the SESA × WDCC award"
                width={1200}
                height={900}
                loading="lazy"
              />
            </figure>
            <figure>
              <Image
                src={photos.sesaCert}
                alt="SESA × WDCC certificate"
                width={1200}
                height={900}
                loading="lazy"
              />
            </figure>
          </div>
          <div class="prize">Most overengineered</div>
          <h3>SESA × WDCC</h3>
          <p>
            August 2025 — at New Zealand's largest tertiary hackathon, a 48-hour
            sprint at GridAKL that earned the most delightfully overbuilt award.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section-pad contact" id="contact">
    <div class="wrap">
      <div class="contact-panel" data-reveal>
        <div class="eyebrow">Next chapter</div>
        <h2>Let's make<br />something wonderful.</h2>
        <p class="lead">
          Whether you want to collaborate on open source, build a product
          together, or just say kia ora — I'd love to hear from you.
        </p>
        <div class="contact-actions">
          <a
            class="btn btn-primary"
            href="mailto:taroj1205@gmail.com"
            data-magnetic
          >
            Email me
            <svg
              class="btn-arrow"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            class="btn btn-ghost"
            href="https://github.com/sponsors/taroj1205"
            target="_blank"
            rel="noopener noreferrer"
            data-magnetic
          >
            Sponsor on GitHub
          </a>
        </div>
        <div class="social-row">
          <a
            href="https://github.com/taroj1205"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          <a
            href="https://x.com/taroj1205"
            target="_blank"
            rel="noopener noreferrer">X / Twitter</a
          >
          <a
            href="https://www.linkedin.com/in/taroj/"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <a
            href="https://zenn.dev/taroj1205"
            target="_blank"
            rel="noopener noreferrer">Zenn</a
          >
          <a href="/about">More about me</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '../layouts/layout.astro'
import { projects } from '../lib/projects.astro'
---

<Layout
  title="Projects — Shintaro Jokagi"
  description="Selected projects by Shintaro Jokagi — web apps, desktop tools, and open-source experiments."
>
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Projects</div>
      <h1>Selected builds.</h1>
      <p class="lead">
        A mix of product work, desktop experiments, and tools built for people I
        care about.
      </p>
    </div>
  </section>

  <section class="section-pad" style="padding-top: 1.5rem">
    <div class="wrap">
      <div class="work-grid">
        {
          projects.map((project, i) => (
            <a
              class="work-card"
              href={project.link || project.github}
              target="_blank"
              rel="noopener noreferrer"
              data-reveal
              style={`--delay: ${Math.min(i * 70, 280)}ms`}
            >
              <div class="tag-row">
                {project.lang.map((l: string) => (
                  <span class="tag">{l}</span>
                ))}
                {project.framework.map((f: string) => (
                  <span class="tag warm">{f}</span>
                ))}
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="footer">
                <div class="metric">
                  Explore
                  <small>{project.framework[0] || project.lang[0]}</small>
                </div>
                <span class="go" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path
                      d="M7 17L17 7M9 7h8v8"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

---
import { getCollection } from 'astro:content'
import Layout from '../layouts/layout.astro'

const posts = await getCollection('blog')
posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)
---

<Layout
  title="Blog · Shintaro Jokagi"
  description="Occasional writing by Shintaro Jokagi."
>
  <section class="page wrap">
    <h1>Blog</h1>
    <p class="intro">Occasional writing, not very often.</p>
    <ul class="posts">
      {
        posts.map(post => (
          <li>
            <a
              href={`/blog/${post.filePath?.split('/').pop()?.split('.').shift()}`}
            >
              {post.data.title}
            </a>
            <time datetime={post.data.date}>
              {new Date(post.data.date).toLocaleDateString('en-NZ', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .posts {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    max-width: 44rem;
    border-top: 1px solid var(--line);
  }

  .posts li {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .posts a {
    font-size: 1.3rem;
    font-weight: 650;
    color: var(--ink);
  }

  .posts time {
    color: var(--stone);
    font-size: 0.9375rem;
  }
</style>

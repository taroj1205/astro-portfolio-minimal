---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Layout from '../layouts/layout.astro'
import japanOsaka from '../assets/photos/japan-osaka.jpg'
import aucklandCbd from '../assets/photos/auckland-cbd.jpg'
import nzSunsetFrame from '../assets/photos/nz-sunset-frame.jpg'
import nzHeadland from '../assets/photos/nz-headland.jpg'
import nzBeach from '../assets/photos/nz-beach.jpg'
import nzCoast from '../assets/photos/nz-coast.jpg'
import nzCliffs from '../assets/photos/nz-cliffs.jpg'

interface Shot {
  src: ImageMetadata
  alt: string
  caption: string
  width: number
  height: number
}

// Second set — swapped in as the story sections scroll
const storyShots: Shot[] = [
  {
    src: nzHeadland,
    alt: 'Black-sand beach and cliffs on the west coast',
    caption: 'West coast, any weather',
    width: 2304,
    height: 4096,
  },
  {
    src: nzBeach,
    alt: 'Walking a black-sand beach on the west coast',
    caption: 'Showing up, most days',
    width: 1170,
    height: 1560,
  },
  {
    src: nzCoast,
    alt: 'Black-sand beach and headlands on the west coast',
    caption: 'The long way around',
    width: 2304,
    height: 4096,
  },
  {
    src: nzCliffs,
    alt: 'Clifftop view over a west-coast bay',
    caption: 'North Head, most weekends',
    width: 4096,
    height: 2304,
  },
]
---

<Layout
  title="About — Shintaro Jokagi"
  description="Japanese-Kiwi software engineer and open-source maintainer based in Auckland. Self-taught builder, Yamada UI maintainer, Zen Browser website architect."
>
  <section class="page-hero about-hero">
    <div class="wrap about-intro">
      <div class="about-intro-copy">
        <div class="eyebrow">About</div>
        <h1>
          A builder shaped by
          <span class="accent">movement</span>.
        </h1>
        <p class="lead">
          Born in Tokyo, grew up moving between Japan, the Philippines, and New
          Zealand. I taught myself to code, still get curious about random
          things, and I'm happiest when something I built actually helps
          someone.
        </p>
      </div>
      <div class="about-intro-visual">
        <div class="about-photo-stack" data-hero-stack>
          <figure class="about-photo about-photo--main" data-hero-photo>
            <Image
              src={nzSunsetFrame}
              alt="Sunset framed by a pōhutukawa tree"
              width={2304}
              height={4096}
              loading="eager"
            />
          </figure>
          <figure class="about-photo about-photo--side" data-hero-photo>
            <Image
              src={japanOsaka}
              alt="Osaka Castle at dusk"
              width={3072}
              height={4096}
              loading="lazy"
            />
          </figure>
          <figure class="about-photo about-photo--cert" data-hero-photo>
            <Image
              src={aucklandCbd}
              alt="Auckland CBD and Sky Tower"
              width={2304}
              height={4096}
              loading="lazy"
            />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad about-body">
    <div class="wrap about-grid">
      <article class="about-story prose">
        <h2 data-story-step="0">The path</h2>
        <p>
          I was born in 2005 in Tokyo. After the 2011 earthquake we moved to
          Ehime. Then a year at an Auckland intermediate, three months in Cebu
          studying English, a year at a British school in the Philippines, and
          back to New Zealand in 2019 — Westlake Boys, then University of
          Auckland.
        </p>
        <p>
          Along the way I tore my ACL three times playing football. The
          rehabilitation taught me patience, consistency, and how much of
          engineering — and life — is just showing up every day.
        </p>

        <h2 data-story-step="1">How I got into software</h2>
        <p>
          I started building in 2022 — typing games, small web apps, whatever I
          felt like shipping. Nobody taught me. By 2024 I was helping run an
          open-source design system, working on a browser website, and teaching
          Japanese kids to code in Minecraft over Zoom.
        </p>
        <p>
          That same year I joined the University of Auckland for a double major
          in Computer Science and IT Management, and started contributing to
          Yamada UI and Zen Browser in earnest.
        </p>

        <h2 data-story-step="2">What I do now</h2>
        <p>
          I'm a software engineer at <strong>Hazumi Inc.</strong>, building
          websites and product stuff remotely from Auckland for the Tokyo team.
          In open source I'm an official <strong>Yamada UI</strong> maintainer and
          the credited <strong>Core Website Architect</strong> for the Zen Browser
          website.
        </p>
        <p>
          I care a lot about the last 10% of a product — the empty states, the
          focus rings, the sentence that makes someone smile, the PR description
          that helps the next reviewer. Great software is mostly about people.
        </p>

        <h2 data-story-step="3">Outside of work</h2>
        <p>
          Kendama, juggling, table tennis, badminton, football, and the
          occasional very overengineered side project. I read a lot, write when
          I can, and compare browsers the way other people compare coffee shops.
        </p>

        <h2>Get in touch</h2>
        <p>
          Email me at
          <a href="mailto:taroj1205@gmail.com">taroj1205@gmail.com</a>
          or find me on
          <a
            href="https://github.com/taroj1205"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          and
          <a
            href="https://x.com/taroj1205"
            target="_blank"
            rel="noopener noreferrer">X</a
          >.
        </p>
      </article>

      <aside class="about-aside" data-story-photos>
        <div class="story-photo-frame" data-story-frame>
          {
            storyShots.map((shot, i) => (
              <figure
                class:list={['story-photo', { 'is-active': i === 0 }]}
                data-story-photo={i}
              >
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  width={shot.width}
                  height={shot.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </figure>
            ))
          }
          <p class="story-photo-caption" data-story-caption>
            {storyShots[0].caption}
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const captions = [
    'West coast evenings',
    'Showing up, most days',
    'The long way around',
    'North Head, most weekends',
  ]

  const photos = Array.from(
    document.querySelectorAll<HTMLElement>('[data-story-photo]')
  )
  const captionEl = document.querySelector<HTMLElement>('[data-story-caption]')
  const steps = Array.from(
    document.querySelectorAll<HTMLElement>('[data-story-step]')
  )

  // Sticky rail photo swap driven by story headings
  if (photos.length && steps.length && 'IntersectionObserver' in window) {
    let active = 0

    const show = (index: number) => {
      if (index === active) return
      photos[active]?.classList.remove('is-active')
      photos[index]?.classList.add('is-active')
      if (captionEl) captionEl.textContent = captions[index] ?? ''
      active = index
    }

    const io = new IntersectionObserver(
      entries => {
        const visible = entries
          .filter(e => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
        if (!visible) return
        const step = visible.target.getAttribute('data-story-step')
        if (step != null) show(Number(step))
      },
      {
        rootMargin: '-35% 0px -45% 0px',
        threshold: [0, 0.25, 0.5, 0.75, 1],
      }
    )

    steps.forEach(step => io.observe(step))
  }
</script>

<style is:global>
  .about-hero .about-intro {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }

  .about-hero .about-intro-copy h1 {
    font-size: clamp(2.8rem, 6.5vw, 4.75rem);
    margin-bottom: 1.25rem;
  }

  .about-hero .about-intro-copy .accent {
    color: var(--cobalt);
  }

  .about-photo-stack {
    position: relative;
    min-height: 420px;
  }

  .about-photo {
    margin: 0;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
    background: var(--paper-deep);
  }

  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-photo--main {
    width: 78%;
    aspect-ratio: 4 / 5;
    transform: rotate(-2deg);
  }

  .about-photo--main img {
    object-position: center 40%;
  }

  .about-photo--side {
    position: absolute;
    right: 0;
    top: 12%;
    width: 42%;
    aspect-ratio: 4 / 5;
    transform: rotate(3deg);
    z-index: 2;
  }

  .about-photo--side img {
    object-position: center 30%;
  }

  .about-photo--cert {
    position: absolute;
    right: 4%;
    bottom: -4%;
    width: 46%;
    aspect-ratio: 5 / 4;
    transform: rotate(-1.5deg);
    z-index: 3;
  }

  .about-photo--cert img {
    object-position: center 40%;
  }

  .about-body {
    padding-top: 1.5rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.7fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .about-story {
    max-width: none;
  }

  .about-aside {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .story-photo-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lift);
    background: var(--paper-deep);
    isolation: isolate;
  }

  .story-photo {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.7s var(--ease-out);
    pointer-events: none;
  }

  .story-photo.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .story-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-photo-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    margin: 0;
    padding: 2.25rem 1.15rem 1rem;
    background: linear-gradient(
      to top,
      rgba(18, 16, 14, 0.55),
      rgba(18, 16, 14, 0)
    );
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .about-hero .about-intro,
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-intro-visual {
      order: -1;
    }

    .about-photo-stack {
      min-height: 340px;
      max-width: 480px;
    }

    .about-aside {
      position: static;
      max-width: 480px;
    }

    .story-photo-frame {
      aspect-ratio: 5 / 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-photo {
      transition: opacity 0.2s linear;
      transform: none;
    }

    .story-photo.is-active {
      transform: none;
    }
  }
</style>

---
import Layout from '../layouts/layout.astro'
---

<Layout title="404 — Shintaro Jokagi">
  <section
    class="page-hero"
    style="min-height: 70svh; display: grid; align-items: center"
  >
    <div class="wrap" style="text-align: center">
      <div class="eyebrow" style="justify-content: center">Lost in space</div>
      <h1 style="font-size: clamp(4rem, 14vw, 8rem); margin-bottom: 1rem">
        404
      </h1>
      <p class="lead" style="margin-inline: auto; margin-bottom: 2rem">
        This page wandered off. Let's get you back to something useful.
      </p>
      <a class="btn btn-primary" href="/" data-magnetic>
        Back home
        <svg
          class="btn-arrow"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 12h14M13 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>

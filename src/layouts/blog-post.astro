---
import ArrowRightIcon from '../icons/arrow-right-icon.astro'
import Layout from './layout.astro'
import type { ImageMetadata } from 'astro'
import Image from '~/components/ui/image.astro'

interface Props {
  frontmatter: {
    title: string
    date: string
    tags?: string[]
    categories?: string[]
    coverImage?: ImageMetadata
    excerpt?: string
  }
}

const { frontmatter } = Astro.props
---

<Layout title={frontmatter.title} description={frontmatter.excerpt}>
  <section class="page-hero">
    <div class="wrap">
      <a
        href="/blog"
        class="btn btn-ghost"
        style="padding: 0.55rem 0.9rem; font-size: 0.9rem; margin-bottom: 1.5rem"
      >
        <ArrowRightIcon
          style="transform: rotate(180deg); width: 14px; height: 14px"
        />
        All posts
      </a>
      <h1>
        <span style={`view-transition-name: blog-title-${Astro.params.slug}`}>
          {frontmatter.title}
        </span>
      </h1>
      <p class="lead">
        {
          new Date(frontmatter.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </p>
    </div>
  </section>

  <section class="section-pad" style="padding-top: 0.5rem">
    <div class="wrap">
      <article class="page-card prose" id="main-content">
        {
          frontmatter.coverImage && (
            <div style="border-radius: 20px; overflow: hidden; margin-bottom: 2rem">
              <Image
                src={frontmatter.coverImage}
                alt={frontmatter.title}
                width={1200}
                height={675}
                loading="eager"
              />
            </div>
          )
        }
        <slot />
      </article>
    </div>
  </section>
</Layout>
